# A TURN relay is needed for reliable WebRTC across cellular networks and
# restrictive Wi-Fi/NAT. Include the UDP and TLS/TCP URLs supplied by your TURN
# provider; TLS on port 443 is the most broadly reachable fallback.
VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
VITE_TURN_USERNAME=replace-with-turn-username
VITE_TURN_CREDENTIAL=replace-with-turn-credential

# Enable only after deploying services/shared-browser and configuring the Netlify function.
VITE_SHARED_BROWSER_ENABLED=false
# Set these as Netlify runtime secrets (never prefix the signing key with VITE_).
BROWSER_SERVICE_URL=wss://browser.example.com/browser
BROWSER_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters-long
